 		zend_argument_error(sodium_exception_ce, 2, "must be a valid base64 variant identifier");
 		RETURN_THROWS();
 	}
@@ -2330,7 +2334,7 @@ PHP_FUNCTION(sodium_base642bin)
 		sodium_remove_param_values_from_backtrace(EG(exception));
 		RETURN_THROWS();
 	}
-	if ((((unsigned int) variant) & ~ 0x6U) != 0x1U) {
+	if (variant < 0 || (zend_ulong) variant > UINT_MAX || (((unsigned int) variant) & ~ 0x6U) != 0x1U) {
 		zend_argument_error(sodium_exception_ce, 2, "must be a valid base64 variant identifier");
 		RETURN_THROWS();
 	}
