+	}
+	if (crypto_pwhash_str_needs_rehash(hash_str, (unsigned long long) opslimit, (size_t) memlimit) == 0) {
 		RETURN_FALSE;
 	}
 	RETURN_TRUE;
@@ -2297,7 +2301,7 @@ PHP_FUNCTION(sodium_bin2base64)
