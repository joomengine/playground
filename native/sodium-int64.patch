diff --git a/libsodium.c b/libsodium.c
index c5170a9..afd7de4 100644
--- a/libsodium.c
+++ b/libsodium.c
@@ -1565,7 +1565,11 @@ PHP_FUNCTION(sodium_crypto_pwhash_str_needs_rehash)
 									&hash_str, &hash_str_len, &opslimit, &memlimit) == FAILURE) {
 		RETURN_THROWS();
 	}
-	if (crypto_pwhash_str_needs_rehash(hash_str, opslimit, memlimit) == 0) {
+	if (memlimit < 0 || memlimit > SIZE_MAX) {
