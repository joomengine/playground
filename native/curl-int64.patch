diff --git a/multi.c b/multi.c
index 09802d7..ffdf56f 100644
--- a/multi.c
+++ b/multi.c
@@ -474,3 +474,11 @@ static bool _php_curl_multi_setopt(php_curlm *mh, zend_long option, zval *zvalue
 			}
-			error = curl_multi_setopt(mh->multi, option, lval);
+			if (option == CURLMOPT_CHUNK_LENGTH_PENALTY_SIZE || option == CURLMOPT_CONTENT_LENGTH_PENALTY_SIZE) {
+				error = curl_multi_setopt(mh->multi, option, (curl_off_t) lval);
+			} else {
+				if (lval < LONG_MIN || lval > LONG_MAX) {
+					zend_argument_value_error(3, "must fit a C long for this cURL option");
+					return false;
+				}
+				error = curl_multi_setopt(mh->multi, option, (long) lval);
+			}
 			break;
