[Unit]
Description=JoomEngine Playground package relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RELAY_HOST=127.0.0.1
Environment=RELAY_PORT=8787
Environment=RELAY_ALLOWED_ORIGINS=https://playground.joomengine.org
ExecStart=/usr/bin/env node /opt/joomengine-playground-relay/server.mjs
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
