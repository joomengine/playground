{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joomengine/playground/relay/config.schema.json",
  "title": "JoomEngine reviewed public-image relay configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "development": { "type": "boolean", "default": false },
    "listen": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "host": { "enum": ["127.0.0.1", "::1", "0.0.0.0", "::"], "default": "127.0.0.1" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8787 }
      }
    },
    "allowedOrigins": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "format": "uri" },
      "description": "Exact canonical HTTPS origins, without a trailing slash. development:true additionally permits explicit HTTP localhost/127.0.0.1/[::1] origins. Never wildcard."
    },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 15000 },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 },
    "requestsPerMinute": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 120 },
    "globalRequestsPerMinute": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 1200 },
    "maxTrackedClients": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 4096 },
    "maxCacheBytes": { "type": "integer", "minimum": 0, "maximum": 268435456, "default": 67108864 },
    "maxCacheEntries": { "type": "integer", "minimum": 0, "maximum": 2048, "default": 128 }
  }
}
