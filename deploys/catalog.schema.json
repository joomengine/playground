{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.joomengine.org/deploys/catalog.schema.json",
  "title": "JoomEngine Playground deploy catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "default",
    "deploys"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "default": {
      "$ref": "./schema.json#/$defs/id"
    },
    "deploys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "file"
        ],
        "properties": {
          "id": {
            "$ref": "./schema.json#/$defs/id"
          },
          "title": {
            "$ref": "./schema.json#/$defs/text"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "file": {
            "type": "string",
            "pattern": "^\\./[a-z0-9][a-z0-9-]{0,63}\\.json$"
          },
          "joomla": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "5",
                "6"
              ]
            }
          }
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "5": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "./schema.json#/$defs/languagePackage"
          }
        },
        "6": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "./schema.json#/$defs/languagePackage"
          }
        }
      }
    },
    "defaultsByJoomla": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "5": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "6": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        }
      }
    }
  }
}
