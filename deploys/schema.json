{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.joomengine.org/deploys/schema.json",
  "title": "JoomEngine Playground deploy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "joomla"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "joomla": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "5",
          "6"
        ]
      }
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "5": {
          "$ref": "#/$defs/configuration"
        },
        "6": {
          "$ref": "#/$defs/configuration"
        }
      }
    },
    "prebuild": {
      "type": "boolean",
      "default": false
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?-[A-Z]{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri-reference"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceUrl": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "languagePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "url",
        "sha256"
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/language"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceUrl": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "format",
        "schemaVersion",
        "joomlaVersion"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceUrl": {
          "$ref": "#/$defs/url"
        },
        "format": {
          "const": "joomengine-playground-export"
        },
        "schemaVersion": {
          "const": 1
        },
        "joomlaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "prefixItems": [
        {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[a-zA-Z][a-zA-Z0-9:_-]*$"
        }
      ],
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "siteName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "initialPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/(?!/)"
        },
        "joomlaVersion": {
          "$ref": "#/$defs/version"
        },
        "phpVersion": {
          "$ref": "#/$defs/version"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "autoLogin": {
          "type": "boolean"
        },
        "hideToolbar": {
          "type": "boolean"
        },
        "persistence": {
          "type": "boolean"
        },
        "extensions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/languagePackage"
          }
        },
        "startupCommands": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "languageTags": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "menus": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/menu"
          }
        },
        "template": {
          "$ref": "#/$defs/template"
        },
        "phpSettings": {
          "$ref": "#/$defs/phpSettings"
        },
        "multilingual": {
          "type": "boolean"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "articles"
      ],
      "properties": {
        "multilingual": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "articles": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/article"
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "alias",
        "language"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/contentKey"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "alias": {
          "$ref": "#/$defs/id"
        },
        "language": {
          "$ref": "#/$defs/language"
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "alias",
        "language",
        "category",
        "introtext"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/contentKey"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "alias": {
          "$ref": "#/$defs/id"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "category": {
          "$ref": "#/$defs/contentKey"
        },
        "introtext": {
          "type": "string",
          "maxLength": 32768
        },
        "fulltext": {
          "type": "string",
          "maxLength": 32768
        },
        "featured": {
          "type": "boolean"
        },
        "home": {
          "type": "boolean"
        }
      }
    },
    "contentKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": true
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "component",
        "view"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/contentKey"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "alias": {
          "$ref": "#/$defs/id"
        },
        "menuType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "component": {
          "type": "string",
          "pattern": "^com_[a-z0-9_]+$"
        },
        "view": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "query": {
          "$ref": "#/$defs/parameters"
        },
        "params": {
          "$ref": "#/$defs/parameters"
        },
        "language": {
          "anyOf": [
            {
              "const": "*"
            },
            {
              "$ref": "#/$defs/language"
            }
          ]
        },
        "home": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        },
        "access": {
          "type": "integer",
          "minimum": 1
        },
        "templateStyle": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "template": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "element": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "styleId": {
          "type": "integer",
          "minimum": 1
        },
        "params": {
          "$ref": "#/$defs/parameters"
        },
        "menuKeys": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentKey"
          }
        }
      }
    },
    "phpSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upload_max_filesize": {
          "type": "string",
          "pattern": "^[0-9]+[MG]$"
        },
        "post_max_size": {
          "type": "string",
          "pattern": "^[0-9]+[MG]$"
        },
        "memory_limit": {
          "type": "string",
          "pattern": "^[0-9]+[MG]$"
        },
        "max_execution_time": {
          "type": "integer",
          "minimum": 0
        },
        "max_input_time": {
          "type": "integer",
          "minimum": 0
        },
        "max_input_vars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jcb": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "php": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "joomlaFallbacks": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
