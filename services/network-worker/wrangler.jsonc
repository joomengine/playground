{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joomengine-network",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RelayCoordinator"
      ]
    },
    {
      "tag": "v2",
      "deleted_classes": [
        "RelayCoordinator"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "joomengine-network-staging",
      "compatibility_flags": [
        "enable_request_signal"
      ],
      "workers_dev": true
    },
    "production": {
      "name": "joomengine-network",
      "compatibility_flags": [
        "enable_request_signal"
      ],
      "workers_dev": true
    }
  }
}
