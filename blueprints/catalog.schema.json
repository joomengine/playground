{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playground.joomengine.org/blueprints/catalog.schema.json",
  "title": "JoomEngine Playground blueprint catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "default", "blueprints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "default": { "$ref": "./schema.json#/$defs/id" },
    "blueprints": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "file"],
        "properties": {
          "id": { "$ref": "./schema.json#/$defs/id" }, "title": { "$ref": "./schema.json#/$defs/text" },
          "description": { "type": "string", "maxLength": 1000 },
          "file": { "type": "string", "pattern": "^\\./[a-z0-9][a-z0-9-]{0,63}\\.json$" }
        }
      }
    },
    "languages": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "5": { "type": "array", "maxItems": 30, "items": { "$ref": "./schema.json#/$defs/languagePackage" } },
        "6": { "type": "array", "maxItems": 30, "items": { "$ref": "./schema.json#/$defs/languagePackage" } }
      }
    }
  }
}
