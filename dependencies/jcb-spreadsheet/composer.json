{
  "name": "joomengine/jcb-spreadsheet-platform",
  "version": "1.0.0",
  "description": "Verified spreadsheet dependencies for JCB on 32-bit PHP WebAssembly",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3 <8.6",
    "maennchen/zipstream-php": "2.4.0",
    "phpoffice/phpspreadsheet": "3.10.8"
  },
  "config": {
    "allow-plugins": false,
    "platform": {
      "php": "8.3.11",
      "php-64bit": false
    },
    "platform-check": true,
    "sort-packages": true
  }
}
